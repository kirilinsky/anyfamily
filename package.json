    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
