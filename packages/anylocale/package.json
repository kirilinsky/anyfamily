{
  "name": "anylocale",
  "version": "0.0.0",
  "description": "Micro locale-info reader — text direction, first day of week, weekend, calendars and time zones for any locale, straight from native Intl.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/cjs-types.mjs",
    "lint": "oxlint src",
    "publint": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "locale",
    "locale-info",
    "rtl",
    "ltr",
    "text-direction",
    "direction",
    "first-day-of-week",
    "week-start",
    "weekend",
    "calendar",
    "time-zone",
    "hour-cycle",
    "numbering-system",
    "intl",
    "i18n",
    "l10n",
    "localization",
    "zero-dependency",
    "typescript",
    "esm",
    "ssr"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^3.2.4",
    "oxlint": "^1.71.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirilinsky/anyfamily.git",
    "directory": "packages/anylocale"
  },
  "author": "Kirilinsky (https://github.com/kirilinsky)",
  "bugs": {
    "url": "https://github.com/kirilinsky/anyfamily/issues"
  },
  "homepage": "https://anyfamily.site/anylocale"
}
