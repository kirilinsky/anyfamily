{
  "name": "anyfamily",
  "version": "2.1.1",
  "description": "The whole any* family in one install — anywhen, anyamount, anymany, anyaround, anylong, anyplural, anyword and anylocale: micro Intl tools with zero dependencies of their own.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/cjs-types.mjs",
    "knip": "knip",
    "lint": "oxlint src",
    "publint": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "intl",
    "i18n",
    "l10n",
    "localization",
    "zero-dependencies",
    "formatter",
    "date",
    "relative-time",
    "number",
    "currency",
    "units",
    "list",
    "listformat",
    "region",
    "language",
    "flags",
    "meta-package",
    "anywhen",
    "anyamount",
    "anymany",
    "anyaround",
    "anylong",
    "duration",
    "anyplural",
    "plural",
    "pluralrules",
    "ordinal",
    "anyword",
    "segmenter",
    "grapheme",
    "word-count",
    "truncate",
    "emoji",
    "anylocale",
    "locale-info",
    "text-direction",
    "rtl",
    "week-start",
    "weekend",
    "calendar"
  ],
  "homepage": "https://anyfamily.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirilinsky/anyfamily.git",
    "directory": "packages/anyfamily"
  },
  "bugs": {
    "url": "https://github.com/kirilinsky/anyfamily/issues"
  },
  "author": "kirilinsky (https://github.com/kirilinsky)",
  "license": "MIT",
  "dependencies": {
    "anyamount": "workspace:^",
    "anyaround": "workspace:^",
    "anylocale": "workspace:^",
    "anylong": "workspace:^",
    "anymany": "workspace:^",
    "anyplural": "workspace:^",
    "anywhen": "workspace:^",
    "anyword": "workspace:^"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "knip": "^6.32.0",
    "oxlint": "^1.71.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
